<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_order_form" model="ir.ui.view">
            <field name="name">purchase.order.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//label[@for='receipt_reminder_email']" position="before">
                    <label for="date_start" string="Service Period"/>
                    <div name="service_period">
                        <field class="oe_inline" name="date_start" nolabel="1"/> to
                        <field class="oe_inline" name="date_end" nolabel="1"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
