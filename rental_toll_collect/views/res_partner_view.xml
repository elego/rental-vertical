<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="res_partner_contract_type_form_view" model="ir.ui.view">
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <page name="sales_purchases" position="inside">
                    <field name="customer_rank"  invisible="1" />
                    <group
                        name="toll_collect"
                        string="Toll Collect"
                        invisible="customer_rank == 0"
                    >
                        <field name="administrative_charge" />
                        <field
                            name="administrative_charge_product"
                            invisible="not administrative_charge"
                            required="administrative_charge"
                        />
                    </group>
                </page>
            </field>
        </record>
    </data>
</odoo>
